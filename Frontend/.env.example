# Operix Frontend Environment Configuration
VITE_API_BASE_URL=http://localhost:8000
VITE_WS_URL=ws://localhost:8000

# Enables live FastAPI/PostgreSQL integration for verified connected modules:
# - Analytics (/api/v1/analytics/*)
# - AI Assistant (/api/v1/assistant/*)
# - Reports (/api/v1/reports/*)
# - Evidence (/api/v1/evidence/*)
# - Rules (/api/v1/rules/*)
# - WebSockets (/ws/v2/events, /api/v1/auth/ws-ticket)
# Pending modules (S-1 through S-4) stay in UI-only mode until their APIs land.
VITE_USE_MOCK_DATA=false
