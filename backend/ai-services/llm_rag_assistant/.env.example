# ===========================================================================
# Operix — LLM / RAG Assistant Environment Configuration Template
# ===========================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit the real .env containing actual secrets to Git.

# --- Environment & Tenancy ---
APP_ENV=development
DEFAULT_FACTORY_ID=aaaaaaaa-0001-0001-0001-000000000001

# --- Operational Database (Read-Only Access) ---
# NOTE: The assistant ONLY issues SELECT statements against operix_db.
# It does NOT create, alter, or drop any operational tables.
DATABASE_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/operix_db

# --- AI Provider Mode Selection ---
# Options for LLM_PROVIDER: "openai" | "ollama" | "mock"
LLM_PROVIDER=openai

# Options for EMBEDDING_PROVIDER: "openai" | "ollama" | "mock"
EMBEDDING_PROVIDER=openai

# --- Cloud Provider: OpenAI Settings ---
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_TIMEOUT_SECONDS=30.0

# --- Local Provider: Ollama Settings ---
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_CHAT_MODEL=llama3.2
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_TIMEOUT_SECONDS=60.0

# --- Knowledge Ingestion & Chunking ---
CHUNK_SIZE=500
CHUNK_OVERLAP=100
MAX_DOCUMENT_SIZE_MB=25

# --- Vector Storage & Retrieval ---
# Options: "numpy_local" (recommended default: zero C-deps, fast on Windows) | "sqlite_vec" | "chroma"
VECTOR_STORE_TYPE=numpy_local
VECTOR_STORE_DIR=./data/vector_store
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.65

# --- Safety Guardrails & Conversation ---
STRICT_GROUNDING=true
MAX_HISTORY_TURNS=6
