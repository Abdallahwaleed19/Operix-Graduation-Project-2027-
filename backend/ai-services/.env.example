# ===========================================================================
# Operix ai-services — environment variables template
# Copy to .env and fill in real values. NEVER commit .env to Git.
# ===========================================================================

# PostgreSQL connection (psycopg 3 async driver)
DATABASE_URL=postgresql+psycopg://postgres:YOUR_PASSWORD@localhost:5432/operix_db

# Factory UUID to scope all analytics queries
OPERIX_FACTORY_ID=aaaaaaaa-0001-0001-0001-000000000001

# Optional analytics thresholds (override defaults in analytics.py)
LOW_PRODUCTIVITY_THRESHOLD=2       # incidents handled below this = low performer
HIGH_PRODUCTIVITY_THRESHOLD=5      # incidents handled above this = high performer
RESOLUTION_RATE_TARGET=0.80        # target % of incidents resolved
