# =============================================================================
# .env.test — Safe test-only environment values
# NEVER copy production values here.
# This file is loaded by conftest.py before any app.* import.
# =============================================================================

# SQLite sync — compatible with existing synchronous SQLAlchemy engine in database.py
# Note: pool_size, max_overflow, connect_timeout are ignored for SQLite (single-file, no pool)
DATABASE_URL=sqlite:///./test_operix.db

# Redis test slot (db=15 is conventionally reserved for testing)
REDIS_URL=redis://localhost:6379/15

# WS ticket signing key — test-only, never production
WS_TICKET_KEY=test-ws-ticket-key-32bytes-min-pad!

# JWT signing secret — test-only
SECRET_KEY=test-secret-key-change-in-prod-32bytes!

# Placeholder for any external API keys required by Settings
DEFAULT_CV_API_KEY=test-cv-api-key-not-real
