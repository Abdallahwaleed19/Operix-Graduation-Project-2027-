# =============================================================================
# Operix Main Backend — Environment Configuration Template
# =============================================================================
# Copy this file to .env and configure for your environment.
# NEVER commit the real .env containing actual secrets to Git.

# --- Application ---
APP_NAME=Operix Industrial AI Safety Platform
APP_ENV=development
DEBUG=true
API_V1_STR=/api/v1
SECRET_KEY=change-this-to-a-super-secret-random-key-in-production-32bytes
HOST=0.0.0.0
PORT=8000
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173,http://127.0.0.1:5173

# --- Multi-Tenancy & Auth ---
DEFAULT_FACTORY_ID=aaaaaaaa-0001-0001-0001-000000000001
ALLOW_TEST_AUTH_FALLBACK=false

# --- Redis & WebSocket Tickets (Required for Backend Startup) ---
REDIS_URL=redis://localhost:6379/0
WS_TICKET_KEY=change-this-to-a-separate-ws-ticket-key-min-32bytes
WS_TICKET_TTL_SECONDS=30
WS_MEMBERSHIP_CHECK_INTERVAL=5

# --- AI Service Storage ---
EVIDENCE_STORAGE_DIR=ai-services/storage/evidence
REPORTS_STORAGE_DIR=ai-services/storage/reports

# --- PostgreSQL Database ---
# Format: postgresql+psycopg://username:password@localhost:5432/operix_db
#
# IMPORTANT SECURITY NOTICE FOR MULTI-TENANT ROW-LEVEL SECURITY (RLS):
# In PostgreSQL, superusers and roles with the 'BYPASSRLS' attribute unconditionally bypass
# all Row-Level Security policies. To enforce tenant isolation, the application MUST connect
# using a dedicated, non-superuser role without BYPASSRLS (e.g. 'operix_app').
#
# Recommended non-superuser role (for production / RLS testing):
DATABASE_URL=postgresql+psycopg://operix_app:12345@localhost:5432/operix_db
#
# Development fallback (if dedicated application role is not yet provisioned):
# DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/operix_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_PRE_PING=true
DB_ECHO=false

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# SMTP Email Settings (required to send invite & approval emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_USE_TLS=true
FRONTEND_APP_URL=http://localhost:3000
